generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  USER
  FARMER
  RESEARCHER
  PROFESSIONAL
  ADMIN
}

enum OrganizationRole {
  OWNER
  MANAGER
  MEMBER
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  farmCases FarmCase[] @relation("FarmCaseGrower")
  farmReviews FarmCase[] @relation("FarmCaseResearcher")
  farmReplies FarmReply[]
  farmTrials FarmTrial[]
  farmResources FarmResource[]
  realtimeNotifications RealtimeNotification[]
  farmerConversationsA FarmerConversation[] @relation("FarmerParticipantA")
  farmerConversationsB FarmerConversation[] @relation("FarmerParticipantB")
  farmerMessages FarmerMessage[]
  id              String                   @id @default(uuid()) @db.Uuid
  email           String                   @unique @db.VarChar(254)
  displayName     String?                  @map("display_name") @db.VarChar(100)
  passwordHash    String?                  @map("password_hash")
  emailVerifiedAt DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  status          AccountStatus            @default(PENDING_VERIFICATION)
  roles           PlatformRole[]           @default([USER])
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(6)
  sessions        AuthSession[]
  tokens          AuthToken[]
  memberships     OrganizationMembership[]
  invitations     OrganizationInvitation[]
  locationReviews ResourceLocationReview[]
  listings CropListing[]
  marketplaceRequests MarketplaceRequest[]
  issueReports IssueReport[]
  createdGroups ResearchGroup[] @relation("GroupCreator")
  groupMemberships GroupMembership[]
  groupInvitations GroupInvitation[] @relation("InvitedToGroup")
  sentGroupInvitations GroupInvitation[] @relation("GroupInviter")
  groupPosts GroupPost[]
  groupObservations GroupObservation[]

  @@map("users")
}

model AuthSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  refreshHash String    @unique @map("refresh_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  purpose   AuthTokenPurpose
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @db.VarChar(160)
  type        String                   @db.VarChar(32)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?                @map("deleted_at") @db.Timestamptz(6)
  suspendedAt DateTime?                @map("suspended_at") @db.Timestamptz(6)
  verifiedAt  DateTime?                @map("verified_at") @db.Timestamptz(6)
  sites       Site[]
  locations   ResourceLocation[]
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  marketplaceProfile MarketplaceProfile?
  listings CropListing[]
  marketplaceRequests MarketplaceRequest[]

  @@map("organizations")
}

enum ResourceCategory {
  FOOD_BANK
  COMMUNITY_FOOD
  FOSTER_SUPPORT
  FARMER
  FARMERS_MARKET
  GROCERY_RESTAURANT
  WHOLESALER
  RESEARCH_CENTER
  EXTENSION_SERVICE
  SPECIALIST
}

model ResourceLocation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  siteId         String? @unique @map("site_id") @db.Uuid
  category       ResourceCategory
  name           String @db.VarChar(160)
  description    String? @db.VarChar(1000)
  addressLabel   String? @map("address_label") @db.VarChar(240)
  // This geography is explicitly approved for public display; Site.exactGeog stays private.
  publicGeog     Unsupported("geography(Point,4326)") @map("public_geog")
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  available      Boolean @default(true)
  acceptedCrops  String[] @default([]) @map("accepted_crops")
  capacityKg     Decimal? @map("capacity_kg") @db.Decimal(12, 2)
  hours          Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site           Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  reviews        ResourceLocationReview[]
  listings       CropListing[]
  marketplaceProfiles MarketplaceProfile[]

  @@index([category, publishedAt, verifiedAt])
  @@index([organizationId], map: "resource_locations_organization_id_idx")
  @@index([publicGeog], type: Gist, map: "resource_locations_public_geog_gist_idx")
  @@map("resource_locations")
}

model ResourceLocationReview {
  id         String @id @default(uuid()) @db.Uuid
  locationId String @map("location_id") @db.Uuid
  reviewerId String @map("reviewer_id") @db.Uuid
  reason     String @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  location   ResourceLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reviewer   User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([locationId, createdAt])
  @@index([reviewerId])
  @@map("resource_location_reviews")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, deletedAt])
  @@map("organization_memberships")
}

model OrganizationInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  invitedById    String           @map("invited_by_id") @db.Uuid
  email          String           @db.VarChar(254)
  role           OrganizationRole
  tokenHash      String           @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([invitedById])
  @@index([expiresAt])
  @@map("organization_invitations")
}

model Site {
  id             String                                @id @default(uuid()) @db.Uuid
  organizationId String                                @map("organization_id") @db.Uuid
  name           String                                @db.VarChar(160)
  // PostGIS geography is accessed by parameterized raw SQL until Prisma supports it.
  exactGeog      Unsupported("geography(Point,4326)")? @map("exact_geog")
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization                          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  resourceLocation ResourceLocation?

  @@index([organizationId])
  @@index([exactGeog], type: Gist, map: "sites_exact_geog_gist_idx")
  @@map("sites")
}

enum ListingMode {
  DONATION
  FREE
  SALE
}
enum QuantityUnit {
  KG
  LB
  BOX
}
enum MarketplaceRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  FULFILLED
}
enum IssueCategory {
  DISEASE
  PEST
  SOIL
  NUTRIENT
  IRRIGATION
  WEATHER
  CROP_FAILURE
}
enum CollaborationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model MarketplaceProfile {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid
  locationId String? @map("location_id") @db.Uuid
  acceptedCrops String[] @default([]) @map("accepted_crops")
  demand String? @db.VarChar(1000)
  quantityLimit Decimal? @map("quantity_limit") @db.Decimal(12,2)
  storageCapacity Decimal? @map("storage_capacity") @db.Decimal(12,2)
  coldStorage Boolean @default(false) @map("cold_storage")
  acceptsSales Boolean @default(false) @map("accepts_sales")
  serviceRadiusKm Int? @map("service_radius_km")
  pickup Boolean @default(true)
  delivery Boolean @default(false)
  hours Json?
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id])
  location ResourceLocation? @relation(fields: [locationId], references: [id])
  @@map("marketplace_profiles")
}

model CropListing {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  creatorId String @map("creator_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  cropName String @map("crop_name") @db.VarChar(120)
  variety String? @db.VarChar(120)
  quantity Decimal @db.Decimal(12,2)
  reservedQuantity Decimal @default(0) @map("reserved_quantity") @db.Decimal(12,2)
  unit QuantityUnit
  harvestDate DateTime @map("harvest_date") @db.Date
  quality String @db.VarChar(500)
  storageConditions String @map("storage_conditions") @db.VarChar(500)
  shelfLifeDays Int @map("shelf_life_days")
  imageKeys String[] @default([]) @map("image_keys")
  pickupAvailability String @map("pickup_availability") @db.VarChar(500)
  pickupFrom DateTime? @map("pickup_from") @db.Timestamptz(6)
  pickupUntil DateTime? @map("pickup_until") @db.Timestamptz(6)
  requiresColdStorage Boolean @default(false) @map("requires_cold_storage")
  mode ListingMode
  price Decimal? @db.Decimal(12,2)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id])
  creator User @relation(fields: [creatorId], references: [id])
  location ResourceLocation @relation(fields: [locationId], references: [id])
  requests MarketplaceRequest[]
  @@index([cropName, expiresAt])
  @@index([creatorId])
  @@index([organizationId, deletedAt])
  @@map("crop_listings")
}

model MarketplaceRequest {
  id String @id @default(uuid()) @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  requesterId String @map("requester_id") @db.Uuid
  clientId String? @map("client_id") @db.Uuid
  mode ListingMode
  quantity Decimal @db.Decimal(12,2)
  status MarketplaceRequestStatus @default(PENDING)
  pickupAt DateTime? @map("pickup_at") @db.Timestamptz(6)
  fulfilledAt DateTime? @map("fulfilled_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  listing CropListing @relation(fields: [listingId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  requester User @relation(fields: [requesterId], references: [id])
  @@index([listingId, status])
  @@unique([listingId, requesterId, clientId])
  @@index([organizationId, createdAt])
  @@map("marketplace_requests")
}

enum IntelligenceKind {
  RECOMMENDATION
  SURPLUS
  DEMAND
  CLASSIFY
  SIMILARITY
}

enum IntelligenceStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

model IntelligenceJob {
  id String @id @default(uuid()) @db.Uuid
  kind IntelligenceKind
  status IntelligenceStatus @default(QUEUED)
  userId String? @map("user_id") @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  subjectId String? @map("subject_id") @db.Uuid
  input Json @default("{}")
  output Json?
  signals Json?
  modelVersion String? @map("model_version")
  error String?
  attempts Int @default(0)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([organizationId, kind, subjectId, createdAt])
  @@index([userId, createdAt])
  @@map("intelligence_jobs")
}

model IssueReport {
  id String @id @default(uuid()) @db.Uuid
  authorId String @map("author_id") @db.Uuid
  cropType String @map("crop_type") @db.VarChar(120)
  category IssueCategory
  title String @db.VarChar(160)
  symptoms String @db.VarChar(2000)
  region String @db.VarChar(160)
  publicLat Decimal? @map("public_lat") @db.Decimal(8,5)
  publicLng Decimal? @map("public_lng") @db.Decimal(8,5)
  observedAt DateTime @map("observed_at") @db.Date
  treatmentHistory String? @map("treatment_history") @db.VarChar(2000)
  imageKeys String[] @default([]) @map("image_keys")
  interests String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  author User @relation(fields: [authorId], references: [id])
  @@index([cropType, category])
  @@map("issue_reports")
}

model ResearchGroup {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(160)
  description String @db.VarChar(1000)
  cropTypes String[] @default([]) @map("crop_types")
  interests String[] @default([])
  creatorId String @map("creator_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  creator User @relation("GroupCreator", fields: [creatorId], references: [id])
  members GroupMembership[]
  posts GroupPost[]
  observations GroupObservation[]
  invitations GroupInvitation[]
  @@map("research_groups")
}

model GroupMembership {
  id String @id @default(uuid()) @db.Uuid
  groupId String @map("group_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role String @default("MEMBER") @db.VarChar(16)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  group ResearchGroup @relation(fields: [groupId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@unique([groupId, userId])
  @@map("group_memberships")
}

model GroupInvitation {
  id String @id @default(uuid()) @db.Uuid
  groupId String @map("group_id") @db.Uuid
  invitedId String @map("invited_id") @db.Uuid
  invitedById String @map("invited_by_id") @db.Uuid
  status CollaborationStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  group ResearchGroup @relation(fields: [groupId], references: [id])
  invited User @relation("InvitedToGroup", fields: [invitedId], references: [id])
  invitedBy User @relation("GroupInviter", fields: [invitedById], references: [id])
  @@unique([groupId, invitedId])
  @@map("group_invitations")
}

model GroupPost {
  id String @id @default(uuid()) @db.Uuid
  groupId String @map("group_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  clientId String? @map("client_id") @db.Uuid
  body String @db.VarChar(3000)
  attachmentKeys String[] @default([]) @map("attachment_keys")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  group ResearchGroup @relation(fields: [groupId], references: [id])
  author User @relation(fields: [authorId], references: [id])
  @@index([groupId, createdAt])
  @@unique([groupId, authorId, clientId])
  @@map("group_posts")
}

model RealtimeOutbox {
  id String @id @default(uuid()) @db.Uuid
  event Json
  scopes Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt, id])
  @@map("realtime_outbox")
}

model RealtimeNotification {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  title String
  organizationIds String[] @default([]) @map("organization_ids") @db.Uuid
  groupId String? @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt DateTime? @map("read_at") @db.Timestamptz(6)

  @@index([userId, createdAt, id])
  @@map("realtime_notifications")
}

model FarmerConversation {
  id String @id @default(uuid()) @db.Uuid
  participantAId String @map("participant_a_id") @db.Uuid
  participantBId String @map("participant_b_id") @db.Uuid
  participantA User @relation("FarmerParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User @relation("FarmerParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages FarmerMessage[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([participantAId, participantBId])
  @@index([participantBId])
  @@map("farmer_conversations")
}

model FarmerMessage {
  id String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  senderId String @map("sender_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid
  body String @db.VarChar(3000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation FarmerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([conversationId, senderId, clientId])
  @@index([conversationId, createdAt, id])
  @@map("farmer_messages")
}

model GroupObservation {
  id String @id @default(uuid()) @db.Uuid
  groupId String @map("group_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  title String @db.VarChar(160)
  method String @db.VarChar(2000)
  observation String @db.VarChar(3000)
  observedAt DateTime @map("observed_at") @db.Date
  attachmentKeys String[] @default([]) @map("attachment_keys")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  group ResearchGroup @relation(fields: [groupId], references: [id])
  author User @relation(fields: [authorId], references: [id])
  @@index([groupId, observedAt])
  @@map("group_observations")
}


enum FarmReplyKind {
  ADVICE
  TRIAL_OFFER
  SAMPLE_REQUEST
}

enum FarmResourceKind {
  GUIDE
  FIELD_REPORT
  RESEARCH
}

model FarmCase {
  id           String      @id @default(uuid()) @db.Uuid
  crop         String      @db.VarChar(80)
  region       String?     @db.VarChar(100)
  description  String      @db.VarChar(2000)
  openToTrials Boolean     @default(false) @map("open_to_trials")
  growerId     String      @map("grower_id") @db.Uuid
  researcherId String?     @map("researcher_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  activityAt   DateTime    @default(now()) @map("activity_at") @db.Timestamptz(6)
  sharedAt     DateTime?   @map("shared_at") @db.Timestamptz(6)
  resolvedAt   DateTime?   @map("resolved_at") @db.Timestamptz(6)
  resolution   String?     @db.VarChar(1200)
  publishFix   Boolean     @default(false) @map("publish_fix")
  grower       User        @relation("FarmCaseGrower", fields: [growerId], references: [id], onDelete: Restrict)
  researcher   User?       @relation("FarmCaseResearcher", fields: [researcherId], references: [id], onDelete: Restrict)
  replies      FarmReply[]

  @@index([growerId, activityAt])
  @@index([researcherId, sharedAt, activityAt])
  @@map("farm_cases")
}

model FarmReply {
  id        String        @id @default(uuid()) @db.Uuid
  kind      FarmReplyKind
  body      String        @db.VarChar(1500)
  caseId    String        @map("case_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  case      FarmCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("farm_replies")
}

model FarmTrial {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(120)
  crop        String   @db.VarChar(80)
  description String   @db.VarChar(1200)
  authorId    String   @map("author_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
  @@map("farm_trials")
}

model FarmResource {
  id        String           @id @default(uuid()) @db.Uuid
  title     String           @db.VarChar(150)
  crop      String           @db.VarChar(80)
  summary   String           @db.VarChar(500)
  kind      FarmResourceKind
  url       String           @unique @db.VarChar(600)
  authorId  String           @map("author_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("farm_resources")
}
