# From apps/api, run `pnpm dev` after copying the repository .env.example to .env.
PORT=3001
DATABASE_URL=postgresql://cropcircle:cropcircle_dev@localhost:5432/cropcircle
REDIS_URL=redis://localhost:6379
REALTIME_PREFIX=cropcircle
ML_SERVICE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
AUTH_SMTP_HOST=127.0.0.1
AUTH_SMTP_PORT=1025
AUTH_MAIL_FROM=no-reply@cropcircle.test
# Set AUTH_JWT_SECRET for a stable key between local restarts. Required in production.
# AUTH_JWT_SECRET=
# AUTH_SMTP_USER=
# AUTH_SMTP_PASSWORD=
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=cropcircle-demo
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_AUTO_CREATE_BUCKET=true
