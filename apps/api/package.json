{
  "name": "@cropcircle/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "test:auth": "node --test ../../infra/scripts/auth.integration.mjs",
    "test:locations:integration": "tsx test/locations.integration.ts",
    "test:stage5:integration": "tsx test/stage5.integration.ts",
    "test:stage7:integration": "tsx test/stage7.integration.ts",
    "test:realtime:integration": "pnpm --filter @cropcircle/shared-types build && pnpm build && tsx test/realtime.integration.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@cropcircle/shared-types": "workspace:*",
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/platform-socket.io": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/websockets": "11.2.11",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "^6.7.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "ioredis": "5.11.1",
    "nodemailer": "10.6.1",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@cropcircle/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.11",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "8.0.2",
    "eslint": "^9.39.0",
    "globals": "^16.3.0",
    "socket.io-client": "4.8.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
