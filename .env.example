# Local development only. Copy to .env before running Compose.
POSTGRES_DB=cropcircle
POSTGRES_USER=cropcircle
POSTGRES_PASSWORD=cropcircle_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
REALTIME_PREFIX=cropcircle
WEB_PORT=3000
API_PORT=3001
ML_PORT=8000
MAIL_PORT=8025
AUTH_SMTP_PORT=1025

# Host-side commands. Compose overrides these URLs with container hostnames.
DATABASE_URL=postgresql://cropcircle:cropcircle_dev@localhost:5432/cropcircle
REDIS_URL=redis://localhost:6379
ML_SERVICE_URL=http://localhost:8000
# Set the same random secret on both backends when testing service authentication.
# Generate it with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ML_SERVICE_KEY=
API_INTERNAL_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_GEOCODE_URL=https://photon.komoot.io/api
NEXT_PUBLIC_ROUTE_URL=https://router.project-osrm.org/route/v1/driving
